# LLM 协议：responses 或 anthropic
LLM_PROTOCOL=

# 模型名称
GPT_LLM_MODEL_ID=
CLAUDE_LLM_MODEL_ID=

# API 密钥
GPT_LLM_API_KEY=
CLAUDE_LLM_API_KEY=

# 服务地址
GPT_LLM_BASE_URL=
CLAUDE_LLM_BASE_URL=

CLAUDE_LLM_MAX_TOKENS=16384

# LLM 主动超时（秒，默认 60）
LLM_TIMEOUT=60

# 服务器配置
HOST=
PORT=

# CORS 配置
CORS_ORIGINS=

# 日志级别
LOG_LEVEL=

# Unsplash 图片服务凭证
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# 高德地图 API 配置
AMAP_API_KEY=

# 持久化后端：sqlite 或 mysql。首次切换 MySQL 前先执行 Alembic 迁移和健康检查。
DATABASE_BACKEND=sqlite
# SQLite 会话记忆路径，同时保存缓存、草稿版本和异步任务。
AGENT_MEMORY_DB_PATH=data/agent_memory.db

# MySQL 8 基础设施。密码只写本地 .env，不要提交到仓库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=travel_agent
MYSQL_TEST_DATABASE=travel_agent_test
MYSQL_USER=travel_agent_app
# 运行时密码建议由 scripts/configure_mysql_app_user.py 写入 .env.local。
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE_SECONDS=1800
MYSQL_POOL_PRE_PING=true
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=30
MYSQL_WRITE_TIMEOUT_SECONDS=30

# Agent 确定性循环与自动修复上限
AGENT_MAX_STEPS=40
AGENT_MAX_ATTEMPTS_PER_ACTION=2
# 同一动作/输入的成功次数上限，以及连续无收益步数上限
AGENT_MAX_REPEATED_ACTION_INPUTS=1
AGENT_MAX_NO_PROGRESS_STEPS=3
# 单个物理步骤最多合并的确定性本地动作数
AGENT_MAX_LOCAL_ACTIONS_PER_STEP=8
AGENT_MAX_REPAIR_ATTEMPTS=2

# 部分可接受结果策略：仅当核心结构、路线、通勤和约束均达标时允许降级完成
AGENT_PARTIAL_ACCEPTANCE_ENABLED=true
AGENT_PARTIAL_ACCEPTANCE_MIN_SCORE=70
AGENT_PARTIAL_ACCEPTANCE_MAX_VALIDATION_ERRORS=2
AGENT_PARTIAL_ACCEPTANCE_MAX_SCHEDULE_OVERTIME_MINUTES=60
AGENT_PARTIAL_ACCEPTANCE_MAX_UNAVAILABLE_ROUTE_LEGS=0
AGENT_PARTIAL_ACCEPTANCE_MAX_EXCESSIVE_COMMUTE_SEGMENTS=0
AGENT_PARTIAL_ACCEPTANCE_MAX_CONSTRAINT_ERRORS=0
AGENT_PARTIAL_ACCEPTANCE_MIN_ATTRACTIONS_PER_DAY=1
AGENT_PARTIAL_ACCEPTANCE_ALLOWED_ERROR_CODES=plan.empty_suggestions,schedule.daily_overtime
AGENT_MAX_ROUTE_OPTIMIZATION_ATTEMPTS=1

# 确定性路线排序候选预算与真实路线接受阈值
ROUTE_OPTIMIZATION_MAX_CANDIDATES=6
ROUTE_OPTIMIZATION_MIN_IMPROVEMENT_PERCENT=10

# 确定性每日时间轴与跨日日程优化
AGENT_MAX_SCHEDULE_OPTIMIZATION_ATTEMPTS=1
SCHEDULE_OPTIMIZATION_MAX_CANDIDATES=6
SCHEDULE_OPTIMIZATION_MIN_IMPROVEMENT_PERCENT=10
SCHEDULE_DEFAULT_START_TIME=09:00
SCHEDULE_DEFAULT_END_TIME=18:00
SCHEDULE_LUNCH_DURATION_MINUTES=60
SCHEDULE_ROUTE_BUFFER_MINUTES=10
SCHEDULE_ATTRACTION_BUFFER_MINUTES=10

# 确定性可执行性约束评估与有界冲突优化
AGENT_MAX_CONSTRAINT_OPTIMIZATION_ATTEMPTS=1
CONSTRAINT_OPTIMIZATION_MAX_CANDIDATES=8
CONSTRAINT_OPTIMIZATION_MIN_IMPROVEMENT_PERCENT=10
CONSTRAINT_LUNCH_WINDOW_START=11:30
CONSTRAINT_LUNCH_WINDOW_END=14:00
CONSTRAINT_DAILY_ATTRACTION_SOFT_LIMIT=5

# 按交通方式评估单段通勤，并有界替换过远景点
AGENT_MAX_COMMUTE_REPLACEMENT_ATTEMPTS=2
COMMUTE_REPLACEMENT_MAX_CANDIDATES=24
AGENT_MAX_COMMUTE_SUPPLEMENT_SEARCHES=2
COMMUTE_SUPPLEMENT_INITIAL_RADIUS_METERS=5000
COMMUTE_SUPPLEMENT_MAX_RADIUS_METERS=20000
COMMUTE_SUPPLEMENT_PAGE_SIZE=20
COMMUTE_SUPPLEMENT_POOL_MAX_CANDIDATES=48
COMMUTE_MAX_WALKING_MINUTES=45
COMMUTE_MAX_TRANSIT_MINUTES=90
COMMUTE_MAX_DRIVING_MINUTES=120

# 最低有效行程内容保障与附近未使用景点回填
AGENT_MIN_TOTAL_ATTRACTIONS=2
AGENT_MAX_CONTENT_REFILL_ATTEMPTS=2
CONTENT_REFILL_MAX_CANDIDATES=24
CONTENT_REFILL_DEFAULT_VISIT_DURATION_MINUTES=120

# Agent 生命周期执行预算
AGENT_MAX_DURATION_SECONDS=180
AGENT_MAX_TOOL_CALLS=15
AGENT_MAX_LLM_CALLS=6

# SQLite 检查点短暂锁定重试（独立于工具重试和工具预算）
AGENT_CHECKPOINT_MAX_ATTEMPTS=3
AGENT_CHECKPOINT_RETRY_BASE_DELAY_SECONDS=0.05
AGENT_CHECKPOINT_RETRY_MAX_DELAY_SECONDS=0.5

# 指数退避：delay=min(max, base*2^(attempt-1)) + [0,jitter]
AGENT_RETRY_BASE_DELAY_SECONDS=0.5
AGENT_RETRY_MAX_DELAY_SECONDS=8
AGENT_RETRY_JITTER_SECONDS=0.25

# 按工具隔离的熔断器
AGENT_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30

# 高德地图 HTTP 主动超时
AMAP_HTTP_CONNECT_TIMEOUT=3.05
AMAP_HTTP_READ_TIMEOUT=10
AMAP_MAX_ATTRACTION_CANDIDATES=8
AMAP_MAX_HOTEL_CANDIDATES=6
# 通用地点搜索最多保留的候选数
AMAP_MAX_POI_CANDIDATES=10
# 每个早餐/午餐/晚餐锚点最多保留的真实餐厅数
AMAP_MAX_RESTAURANT_CANDIDATES_PER_ANCHOR=4
# 单次行程最多查询的餐饮锚点数，防止多日行程产生无界 HTTP 请求
AMAP_MAX_RESTAURANT_SEARCH_ANCHORS=8
# 餐饮周边搜索半径（米）
AMAP_RESTAURANT_SEARCH_RADIUS_METERS=2500
# 餐饮 POI SQLite 缓存；默认 6 小时，避免营业信息长期陈旧
AMAP_RESTAURANT_CACHE_ENABLED=true
AMAP_RESTAURANT_CACHE_TTL_SECONDS=21600
AMAP_MAX_WEATHER_DAYS=7
AMAP_MAX_ROUTE_LEGS=12
AMAP_ROUTE_CACHE_ENABLED=true
AMAP_ROUTE_CACHE_TTL_SECONDS=3600
AMAP_ROUTE_UNAVAILABLE_CACHE_TTL_SECONDS=300

# 阶段五：异步旅行规划任务与后台 Worker
# 是否在 FastAPI 生命周期中启动持久化后台 Worker。
TRIP_TASK_WORKER_ENABLED=true
# 无任务时的队列轮询间隔。
TRIP_TASK_WORKER_POLL_SECONDS=0.5
# Worker 租约与心跳：租约应明显大于心跳间隔和短暂 SQLite 抖动时间。
TRIP_TASK_LEASE_SECONDS=30
TRIP_TASK_HEARTBEAT_SECONDS=5
# 服务关闭时等待当前 Worker 线程退出的最长时间；未完成任务由租约过期后恢复。
TRIP_TASK_SHUTDOWN_TIMEOUT_SECONDS=3
# SSE 查询新事件的间隔和无业务事件时的心跳间隔。
TRIP_TASK_SSE_POLL_SECONDS=0.5
TRIP_TASK_SSE_HEARTBEAT_SECONDS=15
